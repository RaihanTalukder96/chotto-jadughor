NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://chotto:local-development-only@localhost:5432/chotto
DIRECT_URL=postgresql://chotto:local-development-only@localhost:5432/chotto
# Neon CLI writes DATABASE_URL and DATABASE_URL_UNPOOLED to root .env.local.
# Both API runtime and Prisma load that file before these development defaults.
# DATABASE_URL_UNPOOLED=postgresql://...
APP_ORIGIN=http://localhost:5173
SESSION_HOURS=12
ENABLE_DEMO_SEED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Deliberately set only when running npm run bootstrap:
# BOOTSTRAP_USERNAME=
# BOOTSTRAP_PASSWORD=
