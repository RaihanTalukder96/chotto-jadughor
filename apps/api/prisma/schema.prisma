generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
enum Role {
 ADMIN
 MANAGER
 SHOPKEEPER
}
model User {
 id String @id @default(uuid()) @db.Uuid
 username String
 normalizedUsername String @unique
 passwordHash String
 role Role
 active Boolean @default(true)
 mustChangePassword Boolean @default(true)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 sessions Session[]
 calculations Calculation[]
 adjustments StockAdjustment[]
 audits AuditLog[]
}
model Session {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique
 csrf String
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 expiresAt DateTime @db.Timestamptz(3)
 @@index([userId])
 @@index([expiresAt])
}
model RolePermission {
 role Role
 permission String
 @@id([role,permission])
}
model Category {
 id String @id @default(uuid()) @db.Uuid
 name String @unique
 products Product[]
 subcategories Subcategory[]
}
model Subcategory {
 id String @id @default(uuid()) @db.Uuid
 name String
 categoryId String @db.Uuid
 category Category @relation(fields:[categoryId],references:[id])
 products Product[]
 @@unique([categoryId,name])
 @@unique([id,categoryId])
}
model Product {
 id String @id @default(uuid()) @db.Uuid
 productId String @unique
 sku String @unique
 name String
 categoryId String @db.Uuid
 category Category @relation(fields:[categoryId],references:[id])
 subcategoryId String? @db.Uuid
 subcategory Subcategory? @relation(fields:[subcategoryId,categoryId],references:[id,categoryId],onDelete:Restrict)
 description String @default("")
 buyingPrice Decimal @db.Decimal(14,2)
 minPrice Decimal @db.Decimal(14,2)
 maxPrice Decimal @db.Decimal(14,2)
 stock Int @default(0)
 lowStockThreshold Int @default(5)
 archived Boolean @default(false)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 images ProductImage[]
 published Boolean @default(false)
 retailPrice Decimal? @db.Decimal(14,2)
 salePrice Decimal? @db.Decimal(14,2)
 featured Boolean @default(false)
 brand String @default("")
 ageRange String @default("")
 specifications String @default("")
 adjustments StockAdjustment[]
 @@index([archived,categoryId,name])
 @@index([subcategoryId,categoryId])
}
model StoreSettings {
 id String @id @default("main")
 acceptingOrders Boolean @default(false)
 phone String @default("")
 whatsapp String @default("")
 email String @default("")
 address String @default("")
 dhakaDelivery Decimal? @db.Decimal(14,2)
 outsideDelivery Decimal? @db.Decimal(14,2)
 deliveryInfo String @default("")
 returnPolicy String @default("")
 privacyPolicy String @default("")
 announcement String @default("Safe for baby. Easy for parents. Honest price.")
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
model Customer {
 id String @id @default(uuid()) @db.Uuid
 name String
 email String @unique
 passwordHash String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 sessions CustomerSession[]
 orders ShopOrder[]
}
model CustomerSession {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique
 customerId String @db.Uuid
 customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
 expiresAt DateTime @db.Timestamptz(3)
 @@index([expiresAt])
}
enum OrderStatus {
 PENDING
 CONFIRMED
 SHIPPED
 DELIVERED
 CANCELLED
}
model ShopOrder {
 id String @id @default(uuid()) @db.Uuid
 orderNumber String @unique
 requestKey String @unique @db.Uuid
 trackingHash String @unique
 customerId String? @db.Uuid
 customer Customer? @relation(fields:[customerId],references:[id])
 name String
 phone String
 email String @default("")
 address String
 district String
 zone String
 notes String @default("")
 subtotal Decimal @db.Decimal(14,2)
 delivery Decimal @db.Decimal(14,2)
 total Decimal @db.Decimal(14,2)
 status OrderStatus @default(PENDING)
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 updatedAt DateTime @updatedAt @db.Timestamptz(3)
 items ShopOrderItem[]
 @@index([customerId,createdAt])
 @@index([status,createdAt])
}
model ShopOrderItem {
 id String @id @default(uuid()) @db.Uuid
 orderId String @db.Uuid
 order ShopOrder @relation(fields:[orderId],references:[id])
 productId String @db.Uuid
 name String
 sku String
 quantity Int
 unitPrice Decimal @db.Decimal(14,2)
 lineTotal Decimal @db.Decimal(14,2)
}
model ProductImage {
 id String @id @default(uuid()) @db.Uuid
 productId String @unique @db.Uuid
 product Product @relation(fields:[productId],references:[id])
 publicId String @unique
 url String
 thumbnail String
}
model AssetCleanup {
 id String @id @default(uuid()) @db.Uuid
 publicId String @unique
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}
model StockAdjustment {
 id String @id @default(uuid()) @db.Uuid
 productId String @db.Uuid
 product Product @relation(fields:[productId],references:[id])
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id])
 change Int
 reason String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([productId,createdAt])
}
model Calculation {
 id String @id @default(uuid()) @db.Uuid
 reportNumber String @unique
 title String
 notes String
 ownerId String @db.Uuid
 owner User @relation(fields:[ownerId],references:[id])
 preparedBy String
 sourceId String?
 expenses Decimal @db.Decimal(14,2)
 results Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 items CalculationItem[]
 @@index([ownerId,createdAt])
}
model CalculationItem {
 id String @id @default(uuid()) @db.Uuid
 calculationId String @db.Uuid
 calculation Calculation @relation(fields:[calculationId],references:[id])
 snapshot Json
 @@index([calculationId])
}
model AuditLog {
 id String @id @default(uuid()) @db.Uuid
 userId String? @db.Uuid
 user User? @relation(fields:[userId],references:[id])
 action String
 entityId String?
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@index([createdAt])
}
